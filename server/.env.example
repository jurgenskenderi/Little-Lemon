# Copy to server/.env and adjust. Everything here has a working default
# except ANTHROPIC_API_KEY.

PORT=8787
HOST=0.0.0.0
DATABASE_FILE=./data/little-lemon.db
LOG_LEVEL=info

# Optional. Without it the crawler still runs, using the heuristic parser only;
# pages it can't parse are skipped rather than sent to a model.
ANTHROPIC_API_KEY=
EXTRACTION_MODEL=claude-opus-5

# Enables the partner console at /admin and every /api/admin/* route.
# Leave unset and that whole surface 404s (the scrape CLI still works).
ADMIN_TOKEN=

# Crawler politeness. Lowering the delay is the fastest way to get blocked.
SCRAPER_MIN_HOST_DELAY_MS=2000
SCRAPER_TIMEOUT_MS=15000
SCRAPER_MAX_PAGES_PER_VENUE=4
SCRAPER_REFETCH_AFTER_HOURS=168
SCRAPER_USER_AGENT=

# Search defaults (metric — launching in Ontario)
DEFAULT_RADIUS_M=2000
MAX_RADIUS_M=50000
